# Copy to .env at the repo root (never commit real keys)

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Azure failover
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-01

# Optional
# PLAN_AGENTIC=0
# SEMANTIC_LLM_EXTRACT=0
# QDRANT_PATH=
# FRONTEND_URL=http://localhost:5173

# Optional email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
